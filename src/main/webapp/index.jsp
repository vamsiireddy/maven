<!DOCTYPE html>
<html>
<head>
    <title>CI/CD Practice App</title>
    <style>
        body {
            margin: 0;
            font-family: "Segoe UI", Tahoma, Arial, sans-serif;
            background: linear-gradient(135deg, #667eea, #764ba2);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card {
            background: #ffffff;
            padding: 40px;
            border-radius: 12px;
            width: 420px;
            text-align: center;
            box-shadow: 0 10px 25px rgba(0,0,0,0.25);
        }

        h1 {
            color: #4a148c;
            margin-bottom: 10px;
        }

        p {
            color: #333;
            font-size: 16px;
            margin: 8px 0;
        }

        .tech {
            margin-top: 20px;
            padding: 12px;
            background: #f3e5f5;
            border-radius: 8px;
            font-weight: bold;
            color: #6a1b9a;
        }

        .version {
            margin-top: 15px;
            font-size: 14px;
            color: #555;
        }

        .footer {
            margin-top: 20px;
            font-size: 13px;
            color: #888;
        }
    </style>
</head>

<body>
    <div class="card">
        <h1>🚀 CI/CD Practice App</h1>

        <p>Successfully deployed using:</p>

        <div class="tech">
            Git • Jenkins • Maven • Tomcat
        </div>

        <p class="version">
            Version: <strong>1.0</strong>
        </p>

        <div class="footer">
            DevOps CI/CD Pipeline Demo
        </div>
    </div>
</body>
</html>

